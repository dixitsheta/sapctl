# sapctl central config
#
# Copy this file to ~/.config/sapctl/.env and fill in real values.
# sapctl auto-loads it on every invocation; values already present in your
# shell env take precedence over this file.
#
# Format: KEY=VALUE, # for comments. Optional `export `, optional double
# quotes around VALUE. Never overwrites an existing env var.

# ============================================================
# sapctl runtime toggles
# ============================================================

# Append a signed audit event per HTTP call (requires `sapctl audit init`).
# Same effect as --audit on the command line.
# SAPCTL_AUDIT=1

# Emit OTLP-shaped JSON spans on stderr per HTTP attempt.
# SAPCTL_TRACE=1

# Override audit chain + key directory. Default: $XDG_CONFIG_HOME/sapctl/audit
# SAPCTL_AUDIT_DIR=

# Permit integration tests that hit a real SAP tenant in CI.
# SAPCTL_INTEGRATION=1

# ============================================================
# SAP Business Accelerator Hub sandbox (apikey flow)
# Real key is stored via `sapctl auth login --flow apikey --label sandbox`.
# The variable below is for diagnostic curl calls only.
# ============================================================

# SAPCTL_SANDBOX_API_KEY=

# ============================================================
# SAP S/4HANA Cloud Public Edition trial
# (host + Communication User for direct basic-auth runs)
# ============================================================

# SAPCTL_S4_HOST=myXXXXXX-api.s4hana.cloud.sap
# SAPCTL_S4_UI_HOST=myXXXXXX.s4hana.cloud.sap
# SAPCTL_S4_TENANT_ID=myXXXXXX
# SAPCTL_S4_COMM_USER=
# SAPCTL_S4_COMM_PASSWORD=

# ============================================================
# SAP BTP / Datasphere / AI Core (xsuaa flow)
# Real values come from service-key JSON saved via
# `sapctl auth login --flow xsuaa --label <label> ...`. This
# block is for diagnostic curl + scripting only.
# ============================================================

# SAPCTL_BTP_REGION=eu10
# SAPCTL_BTP_GLOBAL_ACCOUNT_ID=
# SAPCTL_BTP_SUBACCOUNT_ID=
# SAPCTL_BTP_SUBDOMAIN=
# SAPCTL_BTP_API=https://api.cf.eu10.hana.ondemand.com
# SAPCTL_DATASPHERE_API=https://<tenant>.eu10.hcs.cloud.sap
# SAPCTL_AICORE_API=https://api.ai.eu10.ml.hana.ondemand.com
# SAPCTL_AICORE_RESOURCE_GROUP=default

# ============================================================
# Cloudflare Pages Functions (set in CF dashboard, NOT here)
# Listed for reference so the operator can see what the web
# layer expects. NEVER commit real values.
# ============================================================

# TURNSTILE_SECRET=
# RESEND_API_KEY=
# CONTACT_TO=your-email@example.com
# CONTACT_FROM=noreply@sapctl.dev
# GITHUB_TOKEN=

# ============================================================
# Local-only diagnostics
# ============================================================

# When set, sapctl prints a one-line summary at startup of which env vars
# were sourced from the file vs the shell. Off by default.
# SAPCTL_DEBUG_ENV=1
